package OOP;
import java.util.Scanner;
public class Factorial {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int n = sc.nextInt();
        int num = n, fact = 1;
        while (n > 0) {
            fact = fact * n;
            n--;
        }
        System.out.println("Factorial of " + num + " is: " + fact);
        sc.close();
    }
}
